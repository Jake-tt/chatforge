# Copy to .env for local development. Never commit real values.
ENV=dev
DATABASE_URL=postgresql+asyncpg://chatforge:chatforge@localhost:5432/chatforge
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string

# fake: echoes messages back, no API key needed
# ollama: a local model (Qwen3 8B by default), no cost
# anthropic: Claude, needs ANTHROPIC_API_KEY
LLM_PROVIDER=fake
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# -1 keeps the model loaded until Ollama stops; a duration like 30m frees the memory
# OLLAMA_KEEP_ALIVE=-1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Web search tool (Tavily, https://tavily.com; free plan: 1,000 searches a month).
# Off unless enabled; enabling without a key fails at startup. Secret Manager in prod.
# Attachments: original files on local disk (their Markdown is in the database)
# ATTACHMENTS_DIR=data/attachments
# Images need a vision model: on with LLM_PROVIDER=anthropic, off for the local model.
# VISION_ENABLED=

# LLM traces to a local Langfuse, for development and evaluation only (refused on Cloud
# Run). Needs: pip install -e ".[observability]". Keys come from the local Langfuse UI.
# LANGFUSE_ENABLED=false
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
# Searches per user per day; the cap fails closed when Redis is down.
# GUEST_DAILY_WEB_SEARCHES=3
# FREE_DAILY_WEB_SEARCHES=20

# Daily token quotas
GUEST_DAILY_TOKENS=20000
FREE_DAILY_TOKENS=200000

# Proxies that append to X-Forwarded-For in front of the app. 0 locally (use the peer
# address); 1 on Cloud Run. Never more than the real count: extra hops trust forged values.
# Required in prod.
TRUSTED_PROXY_HOPS=0

# Payment provider webhooks (POST /webhooks/payments); unset = endpoint not mounted.
# Secret Manager in prod.
# PAYMENT_WEBHOOK_SECRET=
