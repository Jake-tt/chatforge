# Copy to .env for local development. Never commit real values.
ENV=dev
DATABASE_URL=postgresql+asyncpg://chatforge:chatforge@localhost:5432/chatforge
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string

# fake: echoes messages back, no API key needed
# ollama: a local model (Qwen3 8B by default), no cost
# anthropic: Claude, needs ANTHROPIC_API_KEY
LLM_PROVIDER=fake
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Daily token quotas
GUEST_DAILY_TOKENS=20000
FREE_DAILY_TOKENS=200000

# Proxies that append to X-Forwarded-For in front of the app. 0 locally (use the peer
# address); 1 on Cloud Run. Never more than the real count: extra hops trust forged values.
# Required in prod.
TRUSTED_PROXY_HOPS=0

# Payment provider webhooks (POST /webhooks/payments); unset = endpoint not mounted.
# Secret Manager in prod.
# PAYMENT_WEBHOOK_SECRET=
