# Copy to .env for local development. Never commit real values.
ENV=dev
DATABASE_URL=postgresql+asyncpg://chatforge:chatforge@localhost:5432/chatforge
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string

# "fake" echoes messages back (no API key needed). Set to "anthropic" for real replies.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Daily token quotas
GUEST_DAILY_TOKENS=20000
FREE_DAILY_TOKENS=200000
